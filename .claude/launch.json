{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "easywork-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "site-easywork",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../Site-EasyWork",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
